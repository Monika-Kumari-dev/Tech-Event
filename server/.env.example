# HTTP port for the API
PORT=4000

# MongoDB connection string. Leave EMPTY for an in-memory dev database (data is NOT persisted).
# Atlas example: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/qrpass?retryWrites=true&w=majority
MONGODB_URI=

# HS256 secret for staff session tokens (24h). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If empty, a random secret is generated and stored in keys/jwt-secret.txt (dev only).
JWT_SECRET=

# Seeded on boot when the staff collection is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

EVENT_NAME=Teck Fluence X

# Comma-separated allowed CORS origins (empty = allow any origin)
CORS_ORIGIN=

# Set to 1 when running behind a reverse proxy / load balancer (needed for correct rate limiting)
TRUST_PROXY=

# In-memory mode only: number of demo users to create on boot
SEED_DEMO=50
